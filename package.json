{
  "name": "@lodestar-oss/quicksave",
  "version": "0.2.0",
  "license": "MIT",
  "bin": {
    "qs": "./dist/index.mjs",
    "quicksave": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "start": "oxnode ./src/index.ts",
    "build": "tsdown",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run",
    "try": "oxnode ./src/try.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.72",
    "@bomb.sh/router": "0.8.0",
    "@clack/prompts": "1.8.1",
    "@little-nebulae/error": "1.4.1",
    "@little-nebulae/node-env": "0.5.0",
    "@little-nebulae/result": "1.4.0",
    "@little-nebulae/zod-schemas": "0.2.0",
    "ai": "7.0.156",
    "tinyexec": "1.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@little-nebulae/clack": "0.1.0",
    "@oxc-node/cli": "1.0.1",
    "@types/node": "26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "type-fest": "5.10.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1"
}
